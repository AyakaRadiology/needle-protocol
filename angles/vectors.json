                {
                    "x": 0,
                    "y": 0,
                    "z": -1
                }
            ],
            "expect": null,
            "note": "Just under the floor. Two nearly coincident points are detection noise, not an axis."
        },
        {
            "id": "needle-zero-length",
            "fn": "needleInclinationFromVertical",
            "args": [
                {
                    "x": 0,
                    "y": 0,
                    "z": 0
                },
                {
                    "x": 0,
                    "y": 0,
                    "z": 0
                },
                {
                    "x": 0,
                    "y": 0,
                    "z": -1
                }
            ],
            "expect": null
        },
        {
            "id": "needle-no-gravity",
            "fn": "needleInclinationFromVertical",
            "args": [
                {
                    "x": 0,
                    "y": 0,
                    "z": -100
                },
                {
                    "x": 0,
                    "y": 0,
                    "z": 0
                },
                {
                    "x": 0,
                    "y": 0,
                    "z": 0
                }
            ],
            "expect": null,
            "note": "Uncalibrated or storage-corrupted gravity. Null, never a silent 0."
        },
        {
            "id": "needle-nan-tip",
            "fn": "needleInclinationFromVertical",
            "args": [
                {
                    "x": "NaN",
                    "y": 0,
                    "z": -100
                },
                {
                    "x": 0,
                    "y": 0,
                    "z": 0
                },
                {
                    "x": 0,
                    "y": 0,
                    "z": -1
                }
            ],
            "expect": null
        },
        {
            "id": "needle-null-entry",
            "fn": "needleInclinationFromVertical",
            "args": [
                {
                    "x": 0,
                    "y": 0,
