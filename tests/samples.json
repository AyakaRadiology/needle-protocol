        },
        {
            "contract": "DeviceEnvelope",
            "name": "device-legacy-ts-key",
            "why": "The pre-x-version-2.0.0 spelling of t_boot_ms. Rejected here on purpose: a host that reads a boot clock as wall-clock time is wrong by however long the device has been powered.",
            "frame": {
                "v": 1,
                "kind": "evt",
                "type": "data",
                "seq": 1,
                "ts": 1234,
                "payload": { "accel_x": 0.0, "accel_y": 0.0, "accel_z": 1.0 }
            }
        },
        {
            "contract": "DeviceEnvelope",
            "name": "device-status-envelope-version-malformed",
            "why": "`envelope_schema_version` is the number that decides whether this host can read this device, so a two-part \"2.0\" is not a lenient spelling of 2.0.0 — it is a value no comparison can be trusted on. Rejecting it here is what keeps the pattern in the schema load-bearing rather than decorative.",
            "frame": {
                "v": 1,
                "kind": "evt",
                "type": "status",
                "seq": 0,
                "t_boot_ms": 5,
                "payload": { "state": "ready", "envelope_schema_version": "2.0" }
            }
        },
