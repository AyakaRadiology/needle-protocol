        {
            "contract": "DeviceEnvelope",
            "name": "device-payload-belongs-to-another-type",
            "why": "A status payload under type:data. This is the case a naive allOf-if/then codegen accepts, which is why the envelopes are emitted as tagged unions.",
            "frame": {
                "v": 1,
                "kind": "evt",
                "type": "data",
                "seq": 1,
                "t_boot_ms": 1,
                "payload": { "state": "ready" }
