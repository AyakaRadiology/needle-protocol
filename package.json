{
    "name": "needle-protocol",
    "version": "0.1.0",
    "type": "module",
    "private": false,
    "description": "Shared wire contracts, angle conventions and constants for Needle Guide, Needle Simulator and the SCL3300 firmware",
    "license": "UNLICENSED",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/AyakaRadiology/needle-protocol.git"
    },
    "exports": {
        ".": {
            "import": {
                "types": "./dist/esm/index.d.ts",
                "default": "./dist/esm/index.js"
            },
            "require": {
                "types": "./dist/cjs/index.d.ts",
                "default": "./dist/cjs/index.js"
            }
        },
        "./types": {
            "import": {
                "types": "./dist/esm/types.d.ts",
                "default": "./dist/esm/types.js"
            },
            "require": {
                "types": "./dist/cjs/types.d.ts",
                "default": "./dist/cjs/types.js"
            }
        },
        "./constants": {
            "import": {
                "types": "./dist/esm/constants.d.ts",
                "default": "./dist/esm/constants.js"
            },
            "require": {
                "types": "./dist/cjs/constants.d.ts",
                "default": "./dist/cjs/constants.js"
            }
        },
        "./angles": {
            "import": {
                "types": "./dist/esm/angles.d.ts",
                "default": "./dist/esm/angles.js"
            },
            "require": {
                "types": "./dist/cjs/angles.d.ts",
                "default": "./dist/cjs/angles.js"
            }
        },
        "./zod": {
            "import": {
                "types": "./dist/esm/zod.d.ts",
                "default": "./dist/esm/zod.js"
            },
            "require": {
                "types": "./dist/cjs/zod.d.ts",
                "default": "./dist/cjs/zod.js"
            }
        },
        "./src/*": "./gen/ts/*.ts",
        "./schemas/*": "./schemas/*",
        "./angles/vectors.json": "./angles/vectors.json",
        "./tests/samples.json": "./tests/samples.json",
        "./package.json": "./package.json"
    },
    "files": ["dist", "gen/ts", "schemas", "constants/constants.json", "angles", "tests/samples.json", "README.md"],
    "sideEffects": false,
    "peerDependencies": {
        "zod": "^3.23.0 || ^4.0.0"
    },
    "peerDependenciesMeta": {
        "zod": {
            "optional": true
        }
    },
    "scripts": {
        "gen": "tools/gen.sh",
        "build": "node tools/build-ts.mjs",
        "test": "vitest run",
        "typecheck": "tsc --noEmit"
    },
    "devDependencies": {
        "@types/node": "24.9.2",
        "json-schema-to-typescript": "15.0.4",
        "json-schema-to-zod": "2.8.1",
        "typescript": "5.9.3",
        "vitest": "3.2.4",
        "zod": "3.25.76"
    }
}
